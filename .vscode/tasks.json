{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-debug"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "Configure CMake with Debug preset"
    },
    {
      "label": "CMake: Configure (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-release"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "Configure CMake with Release preset"
    },
    {
      "label": "CMake: Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Build project in Debug mode",
      "dependsOn": ["CMake: Configure (Debug)"]
    },
    {
      "label": "CMake: Build (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-release"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "detail": "Build project in Release mode",
      "dependsOn": ["CMake: Configure (Release)"]
    },
    {
      "label": "CMake: Clean (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build/linux-debug",
        "--target",
        "clean"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "Clean Debug build"
    },
    {
      "label": "CMake: Clean (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build/linux-release",
        "--target",
        "clean"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "Clean Release build"
    },
    {
      "label": "Run (Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/build/linux-debug/TestProject",
      "group": "test",
      "problemMatcher": [],
      "detail": "Run the Debug executable",
      "dependsOn": ["CMake: Build (Debug)"]
    },
    {
      "label": "Run (Release)",
      "type": "shell",
      "command": "${workspaceFolder}/build/linux-release/TestProject",
      "group": "test",
      "problemMatcher": [],
      "detail": "Run the Release executable",
      "dependsOn": ["CMake: Build (Release)"]
    }
  ]
}
